# Akaw secrets. Copy to .env and fill only what you use. .env is gitignored and is never
# sent to the dashboard, to flow steps (commands, Claude Code, n8n) or into logs.
# Which tracker, chat, runners and generators you use is chosen in akaw.config.json.

# ---- Server ---------------------------------------------------------------
AKAW_PORT=4747
# Keep 127.0.0.1: the dashboard can run flow steps, so it must not be on the LAN.
AKAW_HOST=127.0.0.1
# AKAW_DATA_DIR=            (default ./data)
# AKAW_CONFIG=              (default ./akaw.config.json)

# Outbound writes (task comments, chat posts). 0 = dry-run: Akaw logs exactly what it
# would send and sends nothing. Reads (task sync, replies) work either way.
AKAW_ALLOW_WRITES=0

# ---- Task tracker (pick one in akaw.config.json) ----------------------------
# Jira Cloud
# JIRA_BASE_URL=https://<your-site>.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# Asana (personal access token)
# ASANA_TOKEN=
# monday.com (API token)
# MONDAY_TOKEN=

# ---- Chat (any number, chosen in akaw.config.json) --------------------------
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=          (Teams Workflows: "post to a channel when a webhook request is received")
# TELEGRAM_BOT_TOKEN=         (chat id goes in akaw.config.json)
# DISCORD_WEBHOOK_URL=
# GOOGLE_CHAT_WEBHOOK_URL=
# CHAT_WEBHOOK_URL=           (n8n, Make or Zapier: on to WhatsApp, email, SMS)

# ---- Art generators ---------------------------------------------------------
# FAL_KEY=                    (fal.ai: Flux, Seedance, Kling, Veo, Hailuo, Recraft, ...)
# REPLICATE_API_TOKEN=
# GEMINI_API_KEY=             (Google AI Studio)
# Higgsfield, Runway and others: through an n8n workflow or Claude Code with your MCP config.

# ---- n8n --------------------------------------------------------------------
# Value of the auth header your n8n webhooks check (header name is in akaw.config.json)
# N8N_AUTH_VALUE=

# ---- Asset library sources --------------------------------------------------
# GOOGLE_DRIVE_TOKEN=         (OAuth access token) or GOOGLE_DRIVE_API_KEY= (link-shared files)
# BOX_TOKEN=

# ---- Legacy (still read if akaw.config.json does not set steps) ---------------
# AKAW_FLOW_REPO=
# AKAW_CMD_DRAFT=
# AKAW_CMD_BUILD=
# AKAW_CMD_QA=
# AKAW_CMD_EXPORT=
# AKAW_CMD_DEPLOY=
