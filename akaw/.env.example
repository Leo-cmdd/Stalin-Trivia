# Akaw local config. Copy to .env and fill in. .env is gitignored and never
# sent to the dashboard, the agents or the flow commands.

# ---- Server ---------------------------------------------------------------
AKAW_PORT=4747
# Keep 127.0.0.1: the dashboard can run local commands, so it must not be on the LAN.
AKAW_HOST=127.0.0.1
# Where state lives (cards, library index, rules, audit). Default: ./data
# AKAW_DATA_DIR=

# Outbound writes (Jira comments, Slack posts). 0 = dry-run: Akaw logs exactly
# what it would send and sends nothing. Reads (Jira sync) work either way.
AKAW_ALLOW_WRITES=0

# ---- Jira (creative cards) ------------------------------------------------
# JIRA_BASE_URL=https://<your-site>.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# Which cards count as playables. Edit to match your board.
# JIRA_JQL=project = <KEY> AND statusCategory != Done AND summary ~ "playable" ORDER BY priority DESC
# Sprint custom field (Jira Cloud default is usually customfield_10020)
# JIRA_SPRINT_FIELD=customfield_10020

# ---- Slack (delivery posts) -----------------------------------------------
# SLACK_WEBHOOK_URL=

# ---- Asset library adapters -----------------------------------------------
# Google Drive: an OAuth access token (preferred) or an API key for link-shared folders
# GOOGLE_DRIVE_TOKEN=
# GOOGLE_DRIVE_API_KEY=
# Box developer/app token
# BOX_TOKEN=

# ---- Your existing playable flow (the agents live in that repo) -------------
# Absolute path of the flow repo on this Mac. Commands run there.
# AKAW_FLOW_REPO=/Users/<you>/code/papaya-creative
# Each command gets {spec} {card} {out} substituted, plus env AKAW_SPEC, AKAW_CARD, AKAW_OUT.
# A command may write {out}/result.json with {"draftUrl","screenshots","buildPath","playLink"}.
# AKAW_CMD_DRAFT=
# AKAW_CMD_BUILD=
# AKAW_CMD_QA=npm run playable:qa:all
# AKAW_CMD_EXPORT=
# Shown to you at the Deploy gate. Akaw never runs it: you do.
# AKAW_CMD_DEPLOY=
